import { useState } from 'react';
import { Head, Link, useForm } from '@inertiajs/react';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Checkbox } from '@/components/ui/checkbox';
import { Badge } from '@/components/ui/badge';
import { 
    GraduationCap, 
    Eye, 
    EyeOff, 
    Shield, 
    Users, 
    BarChart3, 
    DollarSign, 
    MessageSquare, 
    CheckCircle,
    LogIn,
    Mail,
    Lock,
    AlertCircle,
    Zap,
    Crown,
    BookOpen,
    Heart,
    User,
    ArrowRight
} from 'lucide-react';

export default function Login({ status, errors }) {
    const { data, setData, post, processing, reset } = useForm({
        login: '',
        password: '',
        remember: false,
    });

    const [showPassword, setShowPassword] = useState(false);

    const submit = (e) => {
        e.preventDefault();
        post(route('login'), {
            onFinish: () => reset('password'),
        });
    };

    const fillDemoCredentials = (email) => {
        setData({
            ...data,
            login: email,
            password: 'password123'
        });
    };

    return (
        <>
            <Head title="Login - School Portal" />

            <div className="min-h-screen bg-gradient-to-br from-blue-600 via-blue-700 to-purple-800 flex items-center justify-center p-4 relative overflow-hidden">
                {/* Background Pattern */}
                <div className="absolute inset-0 opacity-10">
                    <div className="absolute top-20 left-10 w-72 h-72 bg-white rounded-full blur-3xl"></div>
                    <div className="absolute bottom-20 right-10 w-80 h-80 bg-purple-300 rounded-full blur-3xl"></div>
                    <div className="absolute top-1/2 left-1/2 w-96 h-96 bg-blue-300 rounded-full blur-3xl transform -translate-x-1/2 -translate-y-1/2"></div>
                </div>

                <div className="bg-white/95 backdrop-blur-sm rounded-3xl shadow-2xl overflow-hidden w-full max-w-5xl grid lg:grid-cols-5 min-h-[700px] relative z-10 border border-white/20">
                    {/* Hero Section */}
                    <div className="lg:col-span-2 bg-gradient-to-br from-blue-600 via-blue-700 to-blue-800 text-white p-8 flex flex-col justify-center relative overflow-hidden">
                        {/* Floating Elements */}
                        <div className="absolute top-10 right-10 w-20 h-20 bg-white/10 rounded-full animate-pulse"></div>
                        <div className="absolute bottom-20 left-10 w-16 h-16 bg-white/5 rounded-full animate-bounce"></div>
                        
                        <div className="relative z-10 text-center lg:text-left">
                            <div className="inline-flex items-center justify-center w-20 h-20 bg-white/20 backdrop-blur-sm rounded-2xl mb-6 group hover:scale-110 transition-transform duration-300">
                                <GraduationCap className="w-10 h-10 text-white group-hover:rotate-12 transition-transform duration-300" />
                            </div>
                            
                            <h1 className="text-4xl font-bold mb-3 bg-gradient-to-r from-white to-blue-100 bg-clip-text text-transparent">
                                School Portal
                            </h1>
                            <p className="text-xl opacity-90 mb-8 leading-relaxed">
                                Comprehensive School Management System
                            </p>

                            <div className="space-y-4">
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <Users className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">User & Role Management</span>
                                </div>
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <BarChart3 className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">Academic Performance Tracking</span>
                                </div>
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <CheckCircle className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">Attendance Management</span>
                                </div>
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <DollarSign className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">Financial Management</span>
                                </div>
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <MessageSquare className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">Communication Tools</span>
                                </div>
                                <div className="flex items-center group hover:translate-x-2 transition-transform duration-200">
                                    <div className="w-10 h-10 bg-white/10 rounded-lg flex items-center justify-center mr-4 group-hover:bg-white/20 transition-colors">
                                        <Shield className="w-5 h-5" />
                                    </div>
                                    <span className="text-white/90">Secure & Reliable</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* Login Form */}
                    <div className="lg:col-span-3 p-8 lg:p-12 flex flex-col justify-center bg-gradient-to-br from-gray-50/30 to-white/50 backdrop-blur-sm">
                        <div className="max-w-md mx-auto w-full">
                            <div className="text-center mb-8">
                                <div className="inline-flex items-center justify-center w-16 h-16 bg-gradient-to-r from-blue-100 to-purple-100 rounded-2xl mb-6 shadow-lg group hover:scale-105 transition-transform duration-300">
                                    <LogIn className="w-8 h-8 text-blue-600 group-hover:rotate-12 transition-transform duration-300" />
                                </div>
                                <h2 className="text-3xl font-bold text-gray-900 mb-2">Welcome Back</h2>
                                <p className="text-gray-600">Sign in to your account to continue</p>
                            </div>

                            {/* Status Messages */}
                            {status && (
                                <Card className="mb-6 border-green-200 bg-green-50/80 backdrop-blur-sm">
                                    <CardContent className="p-4">
                                        <div className="flex items-center">
                                            <CheckCircle className="w-5 h-5 text-green-600 mr-3" />
                                            <span className="text-green-700">{status}</span>
                                        </div>
                                    </CardContent>
                                </Card>
                            )}

                            {Object.keys(errors).length > 0 && (
                                <Card className="mb-6 border-red-200 bg-red-50/80 backdrop-blur-sm">
                                    <CardContent className="p-4">
                                        <div className="flex items-center">
                                            <AlertCircle className="w-5 h-5 text-red-600 mr-3" />
                                            <div className="text-red-700">
                                                <strong>Login Failed:</strong> {Object.values(errors)[0]}
                                            </div>
                                        </div>
                                    </CardContent>
                                </Card>
                            )}

                            <Card className="shadow-xl border-0 bg-white/90 backdrop-blur-sm">
                                <CardContent className="p-8">
                                    <form onSubmit={submit} className="space-y-6">
                                        <div className="space-y-2">
                                            <Label htmlFor="login" className="text-sm font-medium text-gray-700 flex items-center">
                                                <Mail className="w-4 h-4 mr-2 text-gray-500" />
                                                Email or Username
                                            </Label>
                                            <Input
                                                id="login"
                                                type="text"
                                                value={data.login}
                                                onChange={(e) => setData('login', e.target.value)}
                                                className="transition-all duration-200 border-gray-200 focus:border-blue-500 focus:ring-blue-500"
                                                placeholder="Enter your email or username"
                                                required
                                                autoFocus
                                                autoComplete="username"
                                            />
                                        </div>

                                        <div className="space-y-2">
                                            <Label htmlFor="password" className="text-sm font-medium text-gray-700 flex items-center">
                                                <Lock className="w-4 h-4 mr-2 text-gray-500" />
                                                Password
                                            </Label>
                                            <div className="relative">
                                                <Input
                                                    id="password"
                                                    type={showPassword ? 'text' : 'password'}
                                                    value={data.password}
                                                    onChange={(e) => setData('password', e.target.value)}
                                                    className="pr-12 transition-all duration-200 border-gray-200 focus:border-blue-500 focus:ring-blue-500"
                                                    placeholder="Enter your password"
                                                    required
                                                    autoComplete="current-password"
                                                />
                                                <Button
                                                    type="button"
                                                    variant="ghost"
                                                    size="sm"
                                                    className="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600 h-full"
                                                    onClick={() => setShowPassword(!showPassword)}
                                                >
                                                    {showPassword ? <EyeOff className="w-4 h-4" /> : <Eye className="w-4 h-4" />}
                                                </Button>
                                            </div>
                                        </div>

                                        <div className="flex items-center space-x-2">
                                            <Checkbox
                                                id="remember"
                                                checked={data.remember}
                                                onCheckedChange={(checked) => setData('remember', checked)}
                                                className="border-gray-300"
                                            />
                                            <Label htmlFor="remember" className="text-sm text-gray-600 cursor-pointer">
                                                Remember me for 30 days
                                            </Label>
                                        </div>

                                        <Button
                                            type="submit"
                                            disabled={processing}
                                            className="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold py-3 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2 transition-all duration-200 disabled:opacity-50 disabled:cursor-not-allowed shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
                                        >
                                            {processing ? (
                                                <div className="flex items-center justify-center">
                                                    <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white mr-2"></div>
                                                    Signing In...
                                                </div>
                                            ) : (
                                                <div className="flex items-center justify-center">
                                                    <LogIn className="w-5 h-5 mr-2" />
                                                    Sign In to Portal
                                                </div>
                                            )}
                                        </Button>
                                    </form>
                                </CardContent>
                            </Card>

                            {/* Demo Accounts */}
                            <Card className="mt-6 shadow-lg border-0 bg-gradient-to-r from-green-50 to-blue-50 backdrop-blur-sm">
                                <CardContent className="p-6">
                                    <div className="flex items-center mb-4">
                                        <div className="w-8 h-8 bg-gradient-to-r from-green-500 to-blue-500 rounded-full flex items-center justify-center mr-3">
                                            <Zap className="w-4 h-4 text-white" />
                                        </div>
                                        <h3 className="font-semibold text-gray-800">Demo Accounts</h3>
                                        <Badge variant="secondary" className="ml-auto text-xs">
                                            Try Now
                                        </Badge>
                                    </div>
                                    
                                    <div className="space-y-3 text-sm">
                                        <div 
                                            className="bg-white/60 rounded-lg p-3 border border-white/50 cursor-pointer hover:bg-white/80 hover:shadow-md transition-all duration-200 group"
                                            onClick={() => fillDemoCredentials('admin@schoolportal.com')}
                                        >
                                            <div className="flex items-center justify-between">
                                                <div className="flex items-center">
                                                    <Crown className="w-4 h-4 text-yellow-500 mr-2" />
                                                    <span className="font-medium text-gray-700">Superuser</span>
                                                </div>
                                                <ArrowRight className="w-4 h-4 text-gray-400 group-hover:text-blue-500 transition-colors" />
                                            </div>
                                            <p className="text-xs text-gray-600 mt-1">admin@schoolportal.com / password123</p>
                                        </div>
                                        
                                        <div 
                                            className="bg-white/60 rounded-lg p-3 border border-white/50 cursor-pointer hover:bg-white/80 hover:shadow-md transition-all duration-200 group"
                                            onClick={() => fillDemoCredentials('teacher@schoolportal.com')}
                                        >
                                            <div className="flex items-center justify-between">
                                                <div className="flex items-center">
                                                    <BookOpen className="w-4 h-4 text-blue-500 mr-2" />
                                                    <span className="font-medium text-gray-700">Teacher</span>
                                                </div>
                                                <ArrowRight className="w-4 h-4 text-gray-400 group-hover:text-blue-500 transition-colors" />
                                            </div>
                                            <p className="text-xs text-gray-600 mt-1">teacher@schoolportal.com / password123</p>
                                        </div>
                                        
                                        <div 
                                            className="bg-white/60 rounded-lg p-3 border border-white/50 cursor-pointer hover:bg-white/80 hover:shadow-md transition-all duration-200 group"
                                            onClick={() => fillDemoCredentials('student@schoolportal.com')}
                                        >
                                            <div className="flex items-center justify-between">
                                                <div className="flex items-center">
                                                    <GraduationCap className="w-4 h-4 text-green-500 mr-2" />
                                                    <span className="font-medium text-gray-700">Student</span>
                                                </div>
                                                <ArrowRight className="w-4 h-4 text-gray-400 group-hover:text-blue-500 transition-colors" />
                                            </div>
                                            <p className="text-xs text-gray-600 mt-1">student@schoolportal.com / password123</p>
                                        </div>
                                    </div>
                                </CardContent>
                            </Card>

                            <div className="mt-8 text-center">
                                <p className="text-xs text-gray-500 flex items-center justify-center">
                                    <Shield className="w-4 h-4 mr-1" />
                                    © {new Date().getFullYear()} School Portal. All rights reserved.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </>
    );
}
